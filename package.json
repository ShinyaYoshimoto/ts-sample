{
	"name": "ts-sample-monorepo",
	"private": true,
	"version": "0.0.0",
	"description": "Typescript sample code collection with monorepo structure",
	"packageManager": "pnpm@10.8.0",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "pnpm -r run build",
		"lint": "pnpm -r run lint",
		"test": "pnpm -r run test --run",
		"postinstall": "pnpm -r run generate || true",
		"format:prettier": "prettier --write .",
		"format:biome": "biome format --write .",
		"lint:biome": "biome lint --write .",
		"check:biome": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@prisma/client": "catalog:",
		"@types/node": "catalog:",
		"eslint": "catalog:",
		"prettier": "catalog:",
		"prisma": "catalog:",
		"ts-node": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	}
}
