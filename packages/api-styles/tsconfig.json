{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": ".",
		"outDir": "dist",
		"types": ["vitest/globals", "node"]
	},
	"include": [
		"domain/**/*.ts",
		"rest/**/*.ts",
		"trpc/**/*.ts",
		"graphql-union/src/**/*.ts",
		"connect-rpc/src/**/*.ts",
		"connect-rpc/*.ts",
		"connect-rpc/generated/**/*.ts",
		"*.ts"
	],
	"exclude": ["node_modules", "dist", "vitest.config.ts"]
}
