{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": ".",
		"outDir": "dist",
		"types": [
			"vitest/globals",
			"node"
		]
	},
	"include": [
		"trpc/**/*.ts",
		"rest/**/*.ts",
		"graphql-union/src/**/*.ts",
		"connect-rpc/src/**/*.ts",
		"connect-rpc/generated/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
